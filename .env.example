NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_PHOTOS_BUCKET=wedding-photos
AI_WORKER_URL=https://YOUR_CLOUD_RUN_URL
AI_WORKER_SECRET=YOUR_WORKER_SECRET

# Worker-only settings
FACE_PROVIDER=dlib
DLIB_MAX_DISTANCE=0.6
DLIB_MAX_IMAGE_SIDE=2400

# Legacy optional CompreFace provider
COMPRE_FACE_URL=https://YOUR_COMPREFACE_HOST
COMPRE_FACE_API_KEY=YOUR_FACE_RECOGNITION_SERVICE_KEY
COMPRE_FACE_MIN_SIMILARITY=0.75
COMPRE_FACE_PREDICTION_COUNT=1000

# Optional legacy AWS provider
AWS_REGION=ap-south-1
AWS_REKOGNITION_COLLECTION=shaadify-face-v1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY